# =============================================================================
# JobForge — environment index (ARCHITECTURE §27). COMMIT THIS FILE; NEVER COMMIT .env
#
#   bash infrastructure/scripts/gen-secrets.sh      -> creates .env with random local secrets
#
# Rules:
#  * Values equal to CHANGE_ME are replaced by gen-secrets.sh. Nothing real lives in this file.
#  * Only NEXT_PUBLIC_* variables may reach the browser, and they must never hold secrets.
#  * Everything runs with ZERO paid services. AI_PROVIDER defaults to "local".
#  * Additive edits only; group new variables under the owning service banner.
# =============================================================================

# ----------------------------- Compose / infrastructure (Dev 3) --------------
# Image tags (override to pin/upgrade)
POSTGRES_IMAGE_TAG=16
REDIS_IMAGE_TAG=7-alpine
KAFKA_IMAGE_TAG=3.8.0
MAILPIT_IMAGE_TAG=latest

# Postgres superuser (infra only; apps NEVER use it). Runtime roles are created by infrastructure/postgres/init.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rock
POSTGRES_DB=jobforge

# Host ports (all bound to 127.0.0.1). Kafka host port 9092 is fixed (advertised listener).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# Kafka (KRaft). Cluster id is not a secret.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# ----------------------------- Shared runtime ---------------------------------
SPRING_PROFILES_ACTIVE=dev

# ----------------------------- Database (backend + ai-service) ----------------
# Role names are fixed by DATABASE_SCHEMA §2 - do not rename.
DB_URL=jdbc:postgresql://localhost:5432/jobforge
DB_USER=jobforge_backend
DB_PASSWORD=rock
DB_MIGRATION_USER=jobforge_owner
DB_MIGRATION_PASSWORD=CHANGE_ME
AI_DB_URL=jdbc:postgresql://localhost:5432/jobforge
AI_DB_USER=jobforge_ai
AI_DB_PASSWORD=rock

# ----------------------------- Redis ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty = no auth (local default). If set, Compose enforces it.
REDIS_PASSWORD=1234

# ----------------------------- Kafka ------------------------------------------
# Apps on the host: localhost:9092. Containers on jobforge-net (later app profile): kafka:19092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ----------------------------- Backend (Dev 1) --------------------------------
# JWT_SECRET must be >= 32 bytes.
JWT_SECRET=GilLeXEK3MkqS6pOovJITP7QBrnUYzyR5CZ1fDhaHg9Vmw8F0dAtx2juWN4bcs
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000

# Mail -> Mailpit in dev (UI http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=rock
MAIL_FROM=no-reply@jobforge.local

# File storage: local | s3 (MinIO profile arrives in a later phase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Dev seed data (dev profile only). Prod admin bootstrap is set only in deployed environments.
# true = create admin@/recruiter@/seeker@jobforge.local + 60 published jobs at backend startup (needs DEV_SEED_PASSWORD, min 12 chars)
SEED_DEV_DATA=true
DEV_SEED_PASSWORD=sumitpandey7498
# ADMIN_BOOTSTRAP_EMAIL=sumitspandey1609@gmail.com
# ADMIN_BOOTSTRAP_PASSWORD=sumitpandey7498

RATE_LIMIT_ENABLED=true
# Redis read-through cache for public facets and skill autocomplete (TTL 60 s / 120 s).
CACHE_ENABLED=true
# Requests per minute per user (or IP) on avatar, company-logo and resume uploads (UPLOAD class).
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ----------------------------- AI (Dev 3) -------------------------------------
AI_SERVICE_URL=http://localhost:8090
AI_INTERNAL_TOKEN=CHANGE_ME
# local (default, no network) | ollama (optional free local LLM) | claude (future)
AI_PROVIDER=local
AI_MODEL=template-v1
OLLAMA_BASE_URL=http://localhost:11434
AI_QUOTA_ENABLED=true
# FUTURE ONLY - NOT required. Read by ai-service only, only when AI_PROVIDER=claude.
# ANTHROPIC_API_KEY=

# ----------------------------- Frontend (Dev 2) -------------------------------
# Browser-safe values only.
NEXT_PUBLIC_APP_NAME=JobForge
NEXT_PUBLIC_API_MOCKING=disabled
# Server-side rewrite target (not exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:8080

# Monitoring profile (docker compose --profile monitoring up -d)
GRAFANA_ADMIN_PASSWORD=1234
# Backend management port for metrics. Leave EMPTY normally (actuator stays on 8080). For the monitoring profile set 9091;
# compose never publishes it to the host and the backend healthcheck follows it.
MANAGEMENT_PORT=
